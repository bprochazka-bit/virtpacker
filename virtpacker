def cmd_list(args):
    if not have("virsh"):
        die("virsh not found")
    names = [n for n in virsh("list", "--all", "--name").splitlines() if n.strip()]
    rows = []
    total = 0
    for name in names:
        state = virsh("domstate", name, check=False).strip() or "unknown"
        on_disk = apparent = 0
        for _dev, path in domain_disks(name):
            p = Path(path)
            if p.is_file():
                st = p.stat()
                on_disk += st.st_blocks * 512
                apparent += st.st_size
        total += on_disk
        rows.append((name, state, on_disk, apparent))

    name_w = max([len("Name")] + [len(r[0]) for r in rows])
    state_w = max([len("State")] + [len(r[1]) for r in rows])
    fmt = "%-*s  %-*s  %12s  %12s"
    header = fmt % (name_w, "Name", state_w, "State", "On disk", "Apparent")
    print(header)
    print("-" * len(header))
    for name, state, on_disk, apparent in rows:
        print(fmt % (name_w, name, state_w, state,
                     human(on_disk), human(apparent)))
    if rows:
        print("-" * len(header))
        print(fmt % (name_w, "total", state_w, "", human(total), ""))


def cmd_export(args):
    if not have("virsh"):
        die("virsh not found")
    if args.all:
        names = [n for n in virsh("list", "--all", "--name").splitlines() if n.strip()]
    else:
        if not args.name:
            die("give a VM name or use --all")
        names = [args.name]
    for name in names:
        print("exporting %s ..." % name)
        export_vm(name, args.outdir, flatten=not args.no_flatten,
                  overwrite=args.overwrite, space_check=not args.no_space_check)


def cmd_import(args):
    if not have("virsh"):
        die("virsh not found")
    owner = None
    if args.owner:
        if ":" in args.owner:
            u, g = args.owner.split(":", 1)
        else:
            u = g = args.owner
        owner = (u, g)
    import_bundle(
        args.bundle,
        images_dir=args.images_dir,
        nvram_dir=args.nvram_dir,
        tpm_dir=args.tpm_dir,
        owner=owner,
        start=args.start,
        new_mac=args.new_mac,
        space_check=not args.no_space_check,
        machine=args.machine,
        keep_machine=args.keep_machine,
        no_overwrite_disks=args.no_overwrite_disks,
    )


def build_parser():
    p = argparse.ArgumentParser(
        prog="virtpacker",
        description="Export and import libvirt VMs as portable bundles.",
    )
    p.add_argument("--version", action="version", version="virtpacker " + VERSION)
    sub = p.add_subparsers(dest="cmd", required=True)

    pl = sub.add_parser("list", help="list domains libvirt knows about")
    pl.set_defaults(func=cmd_list)

    pe = sub.add_parser("export", help="export one VM or all of them")
    pe.add_argument("name", nargs="?", help="VM name (omit with --all)")
    pe.add_argument("-o", "--outdir", default=".", help="where to write bundles")
    pe.add_argument("--all", action="store_true", help="export every domain")
    pe.add_argument("--no-flatten", action="store_true",
                    help="copy disks as-is; refuse if a backing chain exists")
    pe.add_argument("--overwrite", action="store_true",
                    help="replace an existing bundle dir")
    pe.add_argument("--no-space-check", action="store_true",
                    help="skip the destination free-space preflight")
    pe.set_defaults(func=cmd_export)

    pi = sub.add_parser("import", help="import a bundle on this host")
    pi.add_argument("bundle", help="path to the bundle directory")
    pi.add_argument("--images-dir", default=str(DEFAULT_IMAGES_DIR),
                    help="destination for disk images")
    pi.add_argument("--nvram-dir", default=str(DEFAULT_NVRAM_DIR),
                    help="destination for the nvram var store")
    pi.add_argument("--tpm-dir", default=str(SWTPM_BASE),
                    help="destination dir for an explicit-source swtpm file "
                         "(uuid-dir TPM state always goes to its UUID path)")
    pi.add_argument("--owner", help="qemu user[:group] (default auto-detect)")
    pi.add_argument("--new-mac", action="store_true",
                    help="strip fixed MACs so libvirt regenerates them")
    pi.add_argument("--machine",
                    help="set the machine type (e.g. q35); by default a "
                         "versioned type is aliased so the host picks a "
                         "supported version")
    pi.add_argument("--keep-machine", action="store_true",
                    help="keep the bundle's exact machine type instead of "
                         "aliasing it")
    pi.add_argument("--no-overwrite-disks", action="store_true",
                    help="skip copying a disk whose destination already exists "
                         "(reuse images from a previous run instead of "
                         "re-copying)")
    pi.add_argument("--start", action="store_true", help="start the VM after define")
    pi.add_argument("--no-space-check", action="store_true",
                    help="skip the destination free-space preflight")
    pi.set_defaults(func=cmd_import)

    return p


def main():
    args = build_parser().parse_args()
    try:
        args.func(args)
    except RuntimeError as exc:
        die(str(exc))


if __name__ == "__main__":
    main()
